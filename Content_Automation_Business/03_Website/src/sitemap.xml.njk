---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if p.url and not p.data.noindex and not p.url.endsWith(".xml") and not p.url.endsWith(".txt") and p.url != "/404.html" %}
  <url><loc>{{ p.url | absolute(site.baseUrl) }}</loc><lastmod>{{ (p.data.updated or p.date) | isoDate }}</lastmod></url>
{%- endif %}
{%- endfor %}
  <url><loc>{{ "/bundle/" | absolute(site.baseUrl) }}</loc></url>
</urlset>
