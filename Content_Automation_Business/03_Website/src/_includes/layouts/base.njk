<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = ((title + " | " + site.name) if title.length <= 52 else title) if (title and page.url != "/") else (site.name + ": " + site.tagline) %}
{%- set pageDesc = description or site.description %}
{%- set canonical = page.url | absolute(site.baseUrl) %}
{%- set ogImage = ("/assets/og/" + slug + ".png") if (slug and layout == "layouts/article.njk") else "/assets/og/default.png" %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{%- if site.isPreview or noindex %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
{%- if site.url %}
<link rel="canonical" href="{{ canonical }}">
{%- endif %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/article.njk' else 'website' }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage | absolute(site.baseUrl) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/fraunces-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{%- block schema %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{%- if site.isPreview %}
<div class="preview-banner" role="note">Preview build: not published. Search engines are blocked until a site URL is set.</div>
{%- endif %}
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{%- if not hideNewsletter %}
{% include "partials/newsletter.njk" %}
{%- endif %}
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js" defer></script>
{%- if site.cfAnalyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>
{%- endif %}
</body>
</html>
